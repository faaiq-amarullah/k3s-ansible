{% set idx = groups['lb'].index(inventory_hostname) %}
{% set base_priority = 100 %}
{% set priority = base_priority - idx %}
{% set unicast_peers = groups['lb'] | difference([inventory_hostname]) %}
vrrp_track_process chk_haproxy {
    process haproxy
    weight 10
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == groups['lb'][0] else 'BACKUP' }}
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id 51
    priority {{ priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    unicast_src_ip {{ hostvars[inventory_hostname].ansible_default_ipv4.address }}
    unicast_peer {
{% for host in unicast_peers %}
        {{ hostvars[host].ansible_default_ipv4.address }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ keepalived_vip }}
    }
    track_process {
        chk_haproxy
    }
}
